---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="栖迟手札 · 个人专栏与数字花园" activeNav="home">
  <style is:global>
    /* 刊头 Masthead */
    .masthead {
      padding: 52px 0 38px;
      border-bottom: var(--header-border);
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 40px;
      align-items: end;
    }

    .masthead-kicker {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .masthead-title {
      font-family: var(--font-display);
      font-size: clamp(32px, 4.2vw, 46px);
      line-height: 1.18;
      margin: 0 0 14px;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .masthead-sub {
      font-size: 16.5px;
      color: var(--text-secondary);
      margin: 0;
      max-width: 580px;
      line-height: 1.75;
    }

    .author-card {
      background: var(--bg-card);
      border: var(--card-border);
      border-radius: var(--radius-card);
      padding: 22px 24px;
      box-shadow: var(--shadow-card);
    }

    .author-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .author-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 17px;
    }

    .author-role {
      font-size: 12px;
      color: var(--accent);
      background: var(--accent-soft);
      padding: 2px 9px;
      border-radius: 999px;
      font-weight: 600;
    }

    .author-bio {
      font-size: 13.5px;
      color: var(--text-muted);
      margin: 0;
      line-height: 1.68;
    }

    .announcement-bar {
      margin-top: 24px;
      padding: 11px 18px;
      border-radius: var(--radius-card);
      background: var(--accent-soft);
      border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
      color: var(--text-secondary);
      font-size: 13.5px;
      display: none;
    }

    /* 置顶精选大卡 */
    .featured-section {
      margin: 38px 0 18px;
    }

    .section-label {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .featured-card {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 32px;
      background: var(--bg-card);
      border: var(--card-border);
      border-radius: var(--radius-card);
      padding: 28px;
      box-shadow: var(--shadow-card);
      align-items: center;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .featured-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-strong);
    }

    .featured-cover {
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: calc(var(--radius-card) - 2px);
      overflow: hidden;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
    }

    .featured-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }

    .featured-card:hover .featured-cover img {
      transform: scale(1.02);
    }

    .featured-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12.5px;
      color: var(--text-muted);
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .featured-pin {
      color: var(--accent);
      font-weight: 700;
      background: var(--accent-soft);
      padding: 2px 9px;
      border-radius: 999px;
      font-size: 11.5px;
    }

    .featured-title {
      font-family: var(--font-display);
      font-size: clamp(22px, 2.5vw, 29px);
      line-height: 1.32;
      margin: 0 0 14px;
      color: var(--text);
    }

    .featured-summary {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.75;
      margin: 0 0 20px;
    }

    /* 栏目筛选与搜索栏 */
    .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
      margin: 42px 0 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }

    .cat-tabs {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .cat-btn {
      padding: 6px 14px;
      border-radius: var(--radius-btn);
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-muted);
      font-size: 13.5px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .cat-btn:hover {
      color: var(--text);
      background: var(--bg-elevated);
    }

    .cat-btn.active {
      background: var(--bg-card);
      color: var(--accent);
      border-color: var(--border-strong);
      font-weight: 600;
      box-shadow: var(--shadow-card);
    }

    .search-input {
      padding: 8px 14px;
      border-radius: var(--radius-btn);
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text);
      font-size: 13.5px;
      min-width: 230px;
      outline: none;
      transition: border-color 0.15s ease;
    }

    .search-input:focus {
      border-color: var(--accent);
    }

    /* 文章列表流 (Editorial Feed) */
    .essay-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .essay-card {
      background: var(--bg-card);
      border: var(--card-border);
      border-radius: var(--radius-card);
      padding: 26px;
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.18s ease, border-color 0.18s ease;
    }

    .essay-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-strong);
    }

    .essay-card-cover {
      width: 100%;
      height: 176px;
      border-radius: calc(var(--radius-card) - 2px);
      overflow: hidden;
      margin-bottom: 18px;
      border: 1px solid var(--border);
      background: var(--bg-elevated);
    }

    .essay-card-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .essay-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .essay-cat {
      color: var(--accent);
      font-weight: 600;
    }

    .essay-title {
      font-family: var(--font-display);
      font-size: 20px;
      line-height: 1.38;
      margin: 0 0 10px;
      color: var(--text);
    }

    .essay-summary {
      font-size: 14.5px;
      color: var(--text-secondary);
      line-height: 1.72;
      margin: 0 0 18px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .essay-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      font-size: 12px;
      color: var(--text-muted);
    }

    .tag-chip {
      padding: 2px 8px;
      border-radius: 4px;
      background: var(--bg-elevated);
      color: var(--text-secondary);
      font-size: 11.5px;
      cursor: pointer;
    }

    .tag-chip:hover {
      color: var(--accent);
    }

    @media (max-width: 860px) {
      .masthead {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      .featured-card {
        grid-template-columns: 1fr;
      }
      .essay-list {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="container">
    <!-- 刊头 Masthead -->
    <section class="masthead">
      <div>
        <div class="masthead-kicker">
          <span>PERSONAL PUBLICATION &amp; DIGITAL GARDEN</span>
        </div>
        <h1 class="masthead-title" id="hero-title">栖迟手札</h1>
        <p class="masthead-sub" id="hero-subtitle">
          关于产品构建、器物审美与漫长时光的个人写作专栏
        </p>
      </div>

      <aside class="author-card">
        <div class="author-card-head">
          <span class="author-name" id="author-name">林深</span>
          <span class="author-role" id="author-role">独立开发者 · 写作者</span>
        </div>
        <p class="author-bio" id="author-bio">
          在这里记录长期主义的软件工程思考、阅读札记与生活秩序。远离算法信息流的喧嚣，只留存值得反复重读的文字。
        </p>
      </aside>
    </section>

    <div class="announcement-bar" id="announcement-box"></div>

    <!-- 置顶精选文章 -->
    <section class="featured-section" id="featured-wrap" style="display:none;"></section>

    <!-- 栏目导航与关键词搜索 -->
    <div class="filter-bar">
      <div class="cat-tabs" id="cat-tabs">
        <button class="cat-btn active" data-cat="all">全部文章</button>
        <button class="cat-btn" data-cat="essay">随笔思考</button>
        <button class="cat-btn" data-cat="design">器物与排版</button>
        <button class="cat-btn" data-cat="craft">构建手记</button>
        <button class="cat-btn" data-cat="notes">日常札记</button>
      </div>
      <div style="display:flex;gap:8px;align-items:center;">
        <span id="active-tag-indicator" style="display:none;font-size:12.5px;color:var(--accent);cursor:pointer;" title="点击清除标签筛选"></span>
        <input
          type="search"
          id="search-input"
          class="search-input"
          placeholder="搜索文章标题或正文..."
        />
      </div>
    </div>

    <!-- 文章列表 -->
    <section id="posts-container" class="essay-list">
      <div style="grid-column:1/-1;padding:48px 0;text-align:center;color:var(--text-muted);">
        正在展卷...
      </div>
    </section>
  </div>

  <script is:inline>
    const CATEGORY_LABELS = {
      essay: '随笔思考',
      design: '器物与排版',
      craft: '构建手记',
      notes: '日常札记',
      architecture: '构建手记',
      engineering: '工程实践',
      release: '版本手记',
    };

    let currentCategory = 'all';
    let currentTag = '';
    let searchTimer = null;

    function formatDate(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return iso.slice(0, 10);
      return `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    async function loadPortalOverview() {
      try {
        const res = await fetch('/api/cms/overview');
        const data = await res.json();
        if (!data.ok) return;
        const s = data.settings || {};
        window.syncGlobalSiteBranding(s);
        if (s.siteTitle) document.getElementById('hero-title').textContent = s.siteTitle;
        if (s.siteSubtitle) document.getElementById('hero-subtitle').textContent = s.siteSubtitle;
        if (s.authorName) document.getElementById('author-name').textContent = s.authorName;
        if (s.authorRole) document.getElementById('author-role').textContent = s.authorRole;
        if (s.authorBio) document.getElementById('author-bio').textContent = s.authorBio;

        const ann = document.getElementById('announcement-box');
        if (s.announcement && s.announcement.trim()) {
          ann.textContent = s.announcement;
          ann.style.display = 'block';
        } else {
          ann.style.display = 'none';
        }
      } catch (err) {
        console.error('Overview error:', err);
      }
    }

    window.filterByTag = function (e, tag) {
      e.preventDefault();
      e.stopPropagation();
      currentTag = tag;
      const indicator = document.getElementById('active-tag-indicator');
      indicator.textContent = `#${tag} ✕`;
      indicator.style.display = 'inline-block';
      loadPublishedPosts();
    };

    document.getElementById('active-tag-indicator').addEventListener('click', () => {
      currentTag = '';
      document.getElementById('active-tag-indicator').style.display = 'none';
      loadPublishedPosts();
    });

    async function loadPublishedPosts() {
      const q = document.getElementById('search-input').value.trim();
      const params = new URLSearchParams({ status: 'published' });
      if (currentCategory !== 'all') params.set('category', currentCategory);
      if (currentTag) params.set('tag', currentTag);
      if (q) params.set('q', q);

      const res = await fetch(`/api/cms/posts?${params.toString()}`);
      const data = await res.json();
      const featWrap = document.getElementById('featured-wrap');
      const listWrap = document.getElementById('posts-container');

      if (!data.ok) {
        featWrap.style.display = 'none';
        listWrap.innerHTML = `<div style="grid-column:1/-1;padding:40px;text-align:center;color:var(--text-muted);">${escapeHtml(data.error || '加载失败')}</div>`;
        return;
      }

      const posts = data.posts || [];
      if (posts.length === 0) {
        featWrap.style.display = 'none';
        listWrap.innerHTML = `
          <div style="grid-column:1/-1;padding:56px 24px;text-align:center;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-card);color:var(--text-muted);">
            <p style="font-size:15px;margin:0 0 12px;">当前筛选条件下暂无已发布文章</p>
            <a href="/admin/" class="nav-btn">前往写作工作台撰写新篇 →</a>
          </div>
        `;
        return;
      }

      // 在默认全量视图下，提取置顶 (featured) 或第一篇文章作为刊首大卡
      const showFeaturedHero = currentCategory === 'all' && !currentTag && !q;
      const featuredPost = showFeaturedHero ? posts.find((p) => p.featured) || posts[0] : null;
      const restPosts = featuredPost ? posts.filter((p) => p.id !== featuredPost.id) : posts;

      if (featuredPost) {
        const catLabel = CATEGORY_LABELS[featuredPost.category] || featuredPost.category;
        const coverHtml = featuredPost.coverUrl
          ? `<div class="featured-cover"><img src="${escapeHtml(featuredPost.coverUrl)}" alt="${escapeHtml(featuredPost.title)}" /></div>`
          : '';
        featWrap.style.display = 'block';
        featWrap.innerHTML = `
          <div class="section-label">
            <span>FEATURED DISPATCH · 刊首精选</span>
            <span>约 ${featuredPost.readingMinutes || 2} 分钟阅读</span>
          </div>
          <a href="/post/?slug=${encodeURIComponent(featuredPost.slug)}" class="featured-card" style="${!featuredPost.coverUrl ? 'grid-template-columns:1fr;' : ''}">
            ${coverHtml}
            <div>
              <div class="featured-meta">
                <span class="featured-pin">${featuredPost.featured ? '✦ 精选置顶' : '✦ 最新刊发'}</span>
                <span>${escapeHtml(catLabel)}</span>
                <span>·</span>
                <span>${formatDate(featuredPost.published_at || featuredPost.created_at)}</span>
              </div>
              <h2 class="featured-title">${escapeHtml(featuredPost.title)}</h2>
              <p class="featured-summary">${escapeHtml(featuredPost.summary)}</p>
              <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <span style="font-size:13.5px;font-weight:600;color:var(--accent);">阅读全文 →</span>
                <div style="display:flex;gap:6px;">
                  ${(featuredPost.tags || [])
                    .map(
                      (t) =>
                        `<span class="tag-chip" onclick="window.filterByTag(event, '${escapeHtml(t)}')">#${escapeHtml(t)}</span>`
                    )
                    .join('')}
                </div>
              </div>
            </div>
          </a>
        `;
      } else {
        featWrap.style.display = 'none';
      }

      if (restPosts.length === 0) {
        listWrap.innerHTML = '';
        return;
      }

      listWrap.innerHTML = restPosts
        .map((p) => {
          const catLabel = CATEGORY_LABELS[p.category] || p.category;
          const coverBlock = p.coverUrl
            ? `<div class="essay-card-cover"><img src="${escapeHtml(p.coverUrl)}" alt="${escapeHtml(p.title)}" loading="lazy" /></div>`
            : '';
          return `
            <a href="/post/?slug=${encodeURIComponent(p.slug)}" class="essay-card">
              <div>
                ${coverBlock}
                <div class="essay-meta">
                  <span class="essay-cat">${escapeHtml(catLabel)}</span>
                  <span>·</span>
                  <span>${formatDate(p.published_at || p.created_at)}</span>
                  <span>·</span>
                  <span>${p.readingMinutes || 1} 分钟阅读</span>
                </div>
                <h3 class="essay-title">${escapeHtml(p.title)}</h3>
                <p class="essay-summary">${escapeHtml(p.summary)}</p>
              </div>
              <div class="essay-footer">
                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                  ${(p.tags || [])
                    .slice(0, 3)
                    .map(
                      (t) =>
                        `<span class="tag-chip" onclick="window.filterByTag(event, '${escapeHtml(t)}')">#${escapeHtml(t)}</span>`
                    )
                    .join('')}
                </div>
                <span>约 ${p.wordCount || 300} 字</span>
              </div>
            </a>
          `;
        })
        .join('');
    }

    document.querySelectorAll('#cat-tabs .cat-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#cat-tabs .cat-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.getAttribute('data-cat') || 'all';
        loadPublishedPosts();
      });
    });

    document.getElementById('search-input').addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(loadPublishedPosts, 220);
    });

    loadPortalOverview();
    loadPublishedPosts();
  </script>
</BaseLayout>
